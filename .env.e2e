# Playwright e2e env. Fake values only — never real credentials.
# Loaded by `vite --mode e2e` / `vite build --mode e2e`.
VITE_APP_NAME=Pocket Closet
VITE_API_BASE_URL=https://api.pocketcloset.test
VITE_USE_MOCK_API=false
VITE_FIREBASE_API_KEY=playwright-fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=playwright-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=playwright-project
VITE_FIREBASE_STORAGE_BUCKET=playwright-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:playwright
