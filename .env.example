# Copy to `.env.local` for local development. Never commit secrets.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Set the same keys in the Netlify UI (Site settings → Environment variables).

# Public display name for the site chrome.
VITE_APP_NAME=Digital Wardrobe

# App store URLs (public). Landing CTAs stay disabled until these are set.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# Google Analytics 4 measurement ID (public), e.g. G-XXXXXXXXXX.
# Wiring the pixel is out of scope for WARDROBE-105.
VITE_GA_MEASUREMENT_ID=

# Meta Pixel ID (public), numeric.
# Wiring the pixel is out of scope for WARDROBE-105.
VITE_META_PIXEL_ID=

# Public operator contact shown on Terms of Service and Privacy Policy.
# Leave blank to show a store-listing contact fallback. Do not put personal names in copy.
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_CONTACT_URL=
