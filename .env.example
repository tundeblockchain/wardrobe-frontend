# Copy to `.env.local` for local development. Never commit secrets.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Set the same keys in the Netlify UI (Site settings → Environment variables).

# Public display name for the site chrome.
VITE_APP_NAME=Pocket Closet

# App store URLs (public). Landing CTAs stay disabled until these are set.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# Public site origin used for canonical / Open Graph / Twitter URLs (no trailing slash).
# Leave blank to use the current browser origin.
VITE_PUBLIC_SITE_URL=

# Public backend API origin used by /share/:token, /contact, /pricing
# (GET /billing/plans), and signed-in /app calls such as GET /me (no trailing slash).
# Example: https://api.example.com
# Leave blank to show a clear unavailable state on share preview, Contact Us, and Pricing.
# The backend must allowlist this site origin via SUPPORT_CONTACT_ALLOWED_ORIGINS
# (production plus the Netlify deploy-preview origin pattern).
VITE_API_BASE_URL=

# Google Analytics 4 measurement ID (public), e.g. G-XXXXXXXXXX.
# Scripts are injected only when this is a non-empty G- ID. Leave blank to omit GA.
# When set, store CTA clicks send the `store_cta_click` event (not pageview spam).
VITE_GA_MEASUREMENT_ID=

# Meta Pixel ID (public), numeric.
# The pixel is injected only when this is a non-empty numeric ID. Leave blank to omit it.
# When set, store CTA clicks send the `StoreCtaClick` custom event (not PageView).
VITE_META_PIXEL_ID=

# Public operator contact shown on Terms of Service and Privacy Policy.
# Leave blank to show a store-listing contact fallback. Do not put personal names in copy.
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_CONTACT_URL=

# Public Firebase web config for the same project as the mobile app.
# These values are client-safe. Never put Firebase Admin keys in this repo.
# Leave blank until the Firebase console providers and authorized domains are ready.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Use mock API responses in the signed-in app (local/dev). Default false.
# Truthy values: true, 1. Keep false in production.
VITE_USE_MOCK_API=false
